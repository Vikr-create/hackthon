# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database Configuration
# For SQLite (default local fallback):
DATABASE_URL=sqlite:///instance/opportunity_hub.db

# For MySQL (Uncomment to use MySQL):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/opportunity_hub_db

# Default Admin Credentials (Auto-created during seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Default Demo Student Credentials
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=Student@123
